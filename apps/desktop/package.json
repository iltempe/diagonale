{
  "name": "@diagonale/desktop",
  "private": true,
  "version": "1.2.0",
  "description": "Diagonale \u2014 lavagna tattica animata (desktop app for macOS, Windows, Linux).",
  "author": "Diagonale contributors",
  "homepage": "https://diagonalecalcio.it/",
  "license": "Apache-2.0",
  "main": "main.cjs",
  "scripts": {
    "web": "pnpm --filter @diagonale/web build:desktop && node scripts/copy-web.mjs",
    "start": "pnpm run web && electron .",
    "dist": "pnpm run web && electron-builder --publish never",
    "dist:mac": "pnpm run web && electron-builder --mac --publish never",
    "dist:win": "pnpm run web && electron-builder --win --publish never",
    "dist:linux": "pnpm run web && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "io.github.iltempe.diagonale",
    "productName": "Diagonale",
    "copyright": "Apache-2.0 \u00b7 Diagonale contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "web/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.sports",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Diagonale-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Diagonale-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Diagonale-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "Diagonale-windows-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education;Sports",
      "maintainer": "Diagonale contributors <noreply@github.com>",
      "synopsis": "Animated football tactics board",
      "artifactName": "Diagonale-linux-${arch}.${ext}",
      "executableName": "diagonale"
    },
    "executableName": "diagonale"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
