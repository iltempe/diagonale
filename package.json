{
  "name": "diagonale",
  "private": true,
  "version": "1.0.1",
  "description": "Diagonale — lavagna tattica animata open source. La tattica, fase per fase.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @diagonale/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check:i18n": "node scripts/check-i18n.mjs",
    "gen:data": "pnpm --filter @diagonale/core gen:data",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "~5.7.2"
  }
}
